# Environment variables template
# Copy this file to .env.local and fill in your values

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email (optional - for application notifications)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# NOTIFY_EMAIL=careers@cynbit.in

# Database (optional - if using Prisma/Supabase instead of JSON)
# DATABASE_URL=postgresql://user:password@localhost:5432/cynbit_careers
